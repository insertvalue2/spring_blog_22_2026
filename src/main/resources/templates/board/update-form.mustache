{{> layout/header}}

<!-- Summernote Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-bs5.min.css" rel="stylesheet">

<div class="container p-5">

    <div class="card">
        <div class="card-header"><b>글수정하기 화면입니다</b></div>
        <div class="card-body">

            <form action="/board/{{board.id}}/update" method="post">
                <div class="mb-3">
                    <input type="text" class="form-control"
                           placeholder="Enter username"
                           name="username"
                           value="{{board.username}}" readonly>
                </div>

                <div class="mb-3">
                    <input type="text" class="form-control"
                           placeholder="Enter title"
                           name="title"
                           value="{{board.title}}">
                </div>
                <div class="mb-3">
                    <!-- Summernote 에디터 -->
                    <textarea id="summernote" class="form-control" name="content">{{{board.content}}}</textarea>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="premium" id="premium" value="true" {{#board.premium}}checked{{/board.premium}}>
                        <label class="form-check-label" for="premium">
                            유료 게시글로 설정 (500포인트)
                        </label>
                    </div>
                </div>

                <!-- 수정 완료 버튼: 클릭시 폼 데이터가 POST로 전송됨 -->
                <button class="btn btn-primary form-control">글수정하기완료</button>
            </form>

        </div>
    </div>
</div>

<!-- Summernote Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-bs5.min.js"></script>
<script>
    $(document).ready(function() {
        $('#summernote').summernote({
            placeholder: '내용을 입력하세요',
            tabsize: 2,
            height: 400,
            lang: 'ko-KR',
            // 이미지 업로드 콜백 설정 (Base64로 변환)
            callbacks: {
                onImageUpload: function(files) {
                    // Summernote에서 이미지를 업로드할 때 호출되는 콜백
                    // files: 업로드할 파일 배열
                    for (let i = 0; i < files.length; i++) {
                        insertImageAsBase64(files[i]);
                    }
                }
            }
        });

        // 이미지를 Base64로 변환하여 에디터에 삽입하는 함수
        function insertImageAsBase64(file) {
            // FileReader 객체 생성 (파일을 읽기 위한 API)
            let reader = new FileReader();
            
            // 파일 읽기 완료 시 실행되는 콜백
            reader.onload = function(e) {
                // e.target.result: Base64로 인코딩된 이미지 데이터
                // data:image/jpeg;base64,/9j/4AAQSkZJRg... 형태
                let base64Image = e.target.result;
                
                // Summernote 에디터에 Base64 이미지 삽입
                $('#summernote').summernote('insertImage', base64Image);
            };
            
            // 파일 읽기 실패 시 에러 처리
            reader.onerror = function() {
                alert('이미지 읽기에 실패했습니다.');
            };
            
            // 파일을 Data URL(Base64) 형태로 읽기
            // readAsDataURL: 파일을 Base64 인코딩된 문자열로 변환
            reader.readAsDataURL(file);
        }
    });
</script>

{{> layout/footer}}