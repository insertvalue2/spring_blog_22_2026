
{{> layout/header }}

<div class="container p-5">

    <!-- 요청을 하면 localhost:8080/login POST로 요청됨
    username=사용자입력값&password=사용자값 -->
    <div class="card">
        <div class="card-header"><b>로그인을 해주세요</b></div>
        <div class="card-body">
            <form action="/login" method="post" enctype="application/x-www-form-urlencoded">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Enter username" name="username">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="Enter password" name="password">
                </div>
                <button type="submit" class="btn btn-primary form-control mb-3">로그인</button>
                <a  href="https://kauth.kakao.com/oauth/authorize?response_type=code&client_id=13a5d7c18fd6eaa38324e322a010c50e&redirect_uri=http://localhost:8080/user/kakao">
                    <img alt="소셜로그인이미지" src="/img/kakao_login_small.png">
                </a>
            </form>
        </div>
    </div>
</div>

{{> layout/footer }}