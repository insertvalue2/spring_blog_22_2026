{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0"><b>구매 내역</b></h4>
        </div>

        <div class="card-body">
                {{#purchaseList}}
                <!-- 세션 사용자 유료 게시글 구매 내역 반복 문 사용, card 중첩 사용   -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-2">
                                    <a href="/board/{{boardId}}" class="text-decoration-none">
                                        {{boardTitle}}
                                    </a>
                                </h5>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-user"></i> 작성자: {{boardAuthor}}
                                </p>
                                <p class="text-muted mb-0">
                                    <i class="fas fa-calendar"></i> 구매일: {{purchasedAt}}
                                </p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary fs-6">-{{price}} P</span>
                            </div>
                        </div>
                    </div>
                </div>
                {{/purchaseList}}
                {{^purchaseList}}
                <div class="text-center py-5">
                    <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">구매 내역이 없습니다</h5>
                    <p class="text-muted">유료 게시글을 구매해보세요!</p>
                    <a href="/board/list" class="btn btn-primary">게시글 목록으로</a>
                </div>
                {{/purchaseList}}

            <div class="mt-4">
                <a href="/user/detail" class="btn btn-secondary">회원정보로 돌아가기</a>
            </div>
        </div>
    </div>
</div>

{{> layout/footer}}