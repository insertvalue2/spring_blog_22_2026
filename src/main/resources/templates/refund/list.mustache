{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0"><b>환불 요청 내역</b></h4>
        </div>
        <div class="card-body">
            {{#refundList}}
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-2">환불 요청 #{{id}}</h5>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-receipt"></i> 결제 ID: {{paymentId}}
                                </p>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-won-sign"></i> 환불 금액: <span class="fw-bold text-danger">{{amount}} P</span>
                                </p>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-comment"></i> 환불 사유: {{reason}}
                                </p>

                                <p class="text-muted mb-2">
                                    <i class="fas fa-info-circle"></i> 상태:
                                    {{#isPending}}
                                        <span class="badge bg-warning text-dark">{{statusDisplay}}</span>
                                    {{/isPending}}
                                    {{#isApproved}}
                                        <span class="badge bg-success">{{statusDisplay}}</span>
                                    {{/isApproved}}
                                    {{#isRejected}}
                                        <span class="badge bg-secondary">{{statusDisplay}}</span>
                                    {{/isRejected}}
                                </p>
                                {{#isRejected}} <p class="text-muted mb-2">
                                    <i class="fas fa-times-circle"></i> 거절 사유: <span class="text-danger">{{rejectReason}}</span>
                                </p>
                                {{/isRejected}}
                            </div>
                        </div>
                    </div>
                </div>
            {{/refundList}}

            {{^refundList}}
                <div class="text-center py-5">
                    <i class="fas fa-undo fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">환불 요청 내역이 없습니다</h5>
                    <p class="text-muted">결제 내역에서 환불을 요청할 수 있습니다</p>
                    <a href="/user/payment/list" class="btn btn-primary">결제 내역으로</a>
                </div>
            {{/refundList}}

            <div class="mt-4">
                <a href="/user/detail" class="btn btn-secondary">회원정보로 돌아가기</a>
            </div>
        </div>
    </div>
</div>

{{> layout/footer}}