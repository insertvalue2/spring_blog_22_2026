# ============================================================
# 환경변수 템플릿 (Git 에 커밋되는 공개용)
# ============================================================
# 프로젝트를 clone 한 뒤 이 파일을 복사해서 ".env" 로 이름을 바꾸고
# 각자 로컬 값을 채워 넣으세요.
#
#     cp .env.example .env
#
# .env 파일은 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# ============================================================


# ---------- MySQL ----------
DB_URL=jdbc:mysql://localhost:3306/myblog?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your-mysql-password


# ---------- Gmail SMTP ----------
# 일반 비밀번호가 아닌 "앱 비밀번호(16자)" 를 사용해야 합니다.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-digit-app-password


# ---------- 카카오 OAuth ----------
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret


# ---------- 소셜 사용자 임시 비밀번호 ----------
TENCO_KEY=any-non-empty-string


# ---------- PortOne (아임포트) ----------
IMP_REST_API_KEY=your-imp-rest-api-key
IMP_SECRET_KEY=your-imp-secret-key
